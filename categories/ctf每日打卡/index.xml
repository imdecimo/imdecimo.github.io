</span></span><span class="line"><span class="ln">15</span><span class="cl">        <span class="nx">preg_match</span><span class="p">(</span><span class="s1">&#39;/shana|debu|aqua|cute|arg|code|flag|system|exec|passwd|ass|eval|sort|shell|ob|start|mail|\$|sou|show|cont|high|reverse|flip|rand|scan|chr|local|sess|id|source|arra|head|light|read|inc|info|bin|hex|oct|echo|print|pi|\.|\&#34;|\&#39;|log/i&#39;</span><span class="p">,</span> <span class="nv">$_SERVER</span><span class="p">[</span><span class="s1">&#39;QUERY_STRING&#39;</span><span class="p">])</span>
</span></span><span class="line"><span class="ln">16</span><span class="cl">        <span class="p">)</span>  
